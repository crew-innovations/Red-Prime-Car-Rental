# Shared hosting (Hostinger hPanel): the domain points at the project root,
# so send every request into /public. Nothing outside /public (.env, app,
# vendor, storage...) can be reached from the browser.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Extra safety: never serve dotfiles such as .env or .git
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
